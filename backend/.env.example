# ============================================
# PBMP Backend Environment Variables
# ============================================

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here
# Optional; defaults to gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# AstraDB Configuration
ASTRA_DB_API_ENDPOINT=https://your-database-id-region.apps.astra.datastax.co
ASTRA_DB_APPLICATION_TOKEN=AstraCS:your_token_here
ASTRA_DB_NAMESPACE=grow24
PBMP_ASTRA_DB_COLLECTION=pbmp_chat

# Email Configuration — Zoho Mail (send as @grow24.ai)
# Create email (Contact Us) → support@grow24.ai
# Harness CTA / Subscribe → sales@grow24.ai
EMAIL_SERVICE=zoho
EMAIL_USER=support@grow24.ai
EMAIL_PASSWORD=your-zoho-app-password-for-support
EMAIL_FROM_SUPPORT=Grow24 Support <support@grow24.ai>
EMAIL_FROM_SALES=Grow24 Sales <sales@grow24.ai>
# Optional: dedicated sales mailbox SMTP (recommended).
# If omitted, sales@ must be a Zoho alias / Send Mail As of support@.
# SALES_EMAIL_USER=sales@grow24.ai
# SALES_EMAIL_PASSWORD=your-zoho-app-password-for-sales
EMAIL_LOGO_URL=https://grow24.ai/grow24.png
ZOHO_REGION=in
ZOHO_SMTP_PRO=true
# SMTP_HOST=smtppro.zoho.in
# SMTP_PORT=465
# SMTP_SECURE=true
# SENDGRID_API_KEY=SG.your-actual-api-key-here

# Server Configuration
PORT=3000
