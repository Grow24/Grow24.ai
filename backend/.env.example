# ============================================
# PBMP Backend Environment Variables
# ============================================

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here
# Optional; defaults to gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# AstraDB Configuration
ASTRA_DB_API_ENDPOINT=https://your-database-id-region.apps.astra.datastax.co
ASTRA_DB_APPLICATION_TOKEN=AstraCS:your_token_here
ASTRA_DB_NAMESPACE=grow24
PBMP_ASTRA_DB_COLLECTION=pbmp_chat

# Email Configuration — Zoho Mail (send as @grow24.ai)
# The mailbox MUST exist in Zoho Mail, not only in cPanel.
# EMAIL_PASSWORD = Zoho App Password (not the Zoho login password).
EMAIL_SERVICE=zoho
EMAIL_USER=support@grow24.ai
EMAIL_PASSWORD=your-zoho-app-password
EMAIL_FROM=Grow24 <support@grow24.ai>
EMAIL_LOGO_URL=https://grow24.ai/grow24.png
# mail.zoho.com → com    mail.zoho.in → in
ZOHO_REGION=in
# Custom domain uses smtppro automatically; keep this true to force it
ZOHO_SMTP_PRO=true
# Optional explicit host (overrides region/pro detection)
# SMTP_HOST=smtppro.zoho.in
# SMTP_PORT=465
# SMTP_SECURE=true
#
# Legacy fallback only if Zoho credentials are not set
# SENDGRID_API_KEY=SG.your-actual-api-key-here

# Server Configuration
PORT=3000
