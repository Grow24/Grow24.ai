# ============================================
# PBMP Backend Environment Variables
# ============================================

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here
# Optional; defaults to gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# AstraDB Configuration
ASTRA_DB_API_ENDPOINT=https://your-database-id-region.apps.astra.datastax.co
ASTRA_DB_APPLICATION_TOKEN=AstraCS:your_token_here
ASTRA_DB_NAMESPACE=grow24
PBMP_ASTRA_DB_COLLECTION=pbmp_chat

# Email Configuration — Zoho Mail (company mailbox)
# EMAIL_USER must be the full Zoho address (e.g. hello@grow24.ai).
# EMAIL_PASSWORD must be a Zoho App Password if 2FA is on (not the login password).
# EMAIL_FROM must be that same mailbox or an allowed alias.
EMAIL_SERVICE=zoho
EMAIL_USER=your-zoho@grow24.ai
EMAIL_PASSWORD=your-zoho-app-password
EMAIL_FROM=Grow24 <your-zoho@grow24.ai>
EMAIL_LOGO_URL=https://yourdomain.com/logo.png
# com | in | eu | au  (match the Zoho data center for the mailbox)
ZOHO_REGION=com
# Set true for Zoho Workplace / Mail Plus custom domain (smtppro.zoho.*)
# ZOHO_SMTP_PRO=true
#
# Optional SMTP overrides (defaults: smtp.zoho.com, port 465 SSL)
# SMTP_HOST=smtp.zoho.com
# SMTP_PORT=465
# SMTP_SECURE=true
#
# Legacy fallback only if Zoho credentials are not set
# SENDGRID_API_KEY=SG.your-actual-api-key-here

# Server Configuration
PORT=3000
