# PBMP_LibreChat server
PORT=5201
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# Optional live model keys. Without them the orchestration runtime still
# executes agents, subagents, MCP, code interpreter and artifacts locally.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
PERPLEXITY_API_KEY=
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Web search (optional)
TAVILY_API_KEY=

# Code interpreter
CODE_TIMEOUT_MS=8000
PYTHON_BIN=python3
